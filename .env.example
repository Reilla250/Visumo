# Copy to .env and edit.  (Never commit the real .env file.)

# --- Web app -------------------------------------------------------------
PORT=3000
# Set 127.0.0.1 for local-only access; use 0.0.0.0 in a container
HOST=0.0.0.0
# Public address of the site (used for sitemap and social previews), no trailing slash
SITE_URL=http://localhost:3000
# Set to 1 when running behind nginx / a load balancer
TRUST_PROXY=
# Set to true only once the site is served over HTTPS (enables HSTS and upgrade-insecure-requests)
FORCE_HTTPS=false
# Optional public contact email shown on the contact page
CONTACT_EMAIL=visumoadm@gmail.com
# Seconds to cache database content in memory (0 = always query the database)
CACHE_TTL_SECONDS=60

# --- Admin inbox (/admin). Disabled unless ADMIN_PASSWORD is set ----------
ADMIN_USER=admin
ADMIN_PASSWORD=
# Set a random secret for signed admin sessions (generate with node crypto).
SESSION_SECRET=

# --- Database: choose ONE engine -------------------------------------------
# TiDB Cloud Starter speaks the MySQL protocol on port 4000 and requires TLS.
# For local Docker, the compose file overrides these values.
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=4000
DB_NAME=visumo
DB_USER=visumo
DB_PASSWORD=change-me
DB_SSL=true
# Keep a small connection pool for serverless hosting.
DB_POOL_SIZE=2

# --- Docker Compose only -----------------------------------------------------
# (docker-compose.*.yml sets DB_CLIENT / DB_HOST / DB_PORT itself)
# MySQL root password (docker-compose.mysql.yml)
DB_ROOT_PASSWORD=change-me-too
# Port published on the server, and the interface to bind it to.
# Use WEB_BIND=127.0.0.1 when nginx runs on the same server.
WEB_PORT=3000
WEB_BIND=0.0.0.0
