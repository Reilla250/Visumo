<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | ' : '' %><%= c.settings.site_name %> - <%= c.settings.org_full_name %></title>
  <meta name="description" content="<%= description %>">
  <% if (noindex) { %><meta name="robots" content="noindex,nofollow"><% } %>
  <meta name="theme-color" content="#1a6b5a">
  <meta property="og:title" content="<%= title ? title + ' | ' : '' %><%= c.settings.site_name %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <% if (siteUrl) { %><meta property="og:image" content="<%= siteUrl %>/img/hero-community.jpg"><% } %>
  <script>
    (function () {
      var saved = localStorage.getItem('visumo_theme');
      var theme = saved || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=<%= assetV %>">
  <script src="/js/site.js?v=<%= assetV %>" defer></script>
</head>
<body>
<a class="skip" href="#main"><%= lang === 'en' ? 'Skip to main content' : lang === 'sw' ? 'Ruka hadi maudhui' : 'Aller au contenu principal' %></a>

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="VISUMO — <%= t.nav_home %>">
      <img src="/img/visumo-mark.png" alt="" width="40" height="40">
      <span class="brand-name">VISUMO</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="hamburger"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navigation">
      <ul>
        <li><a href="/"<%= active === 'home' ? ' class="active" aria-current="page"' : '' %>><%= t.nav_home %></a></li>

        <li class="has-dropdown<%= active === 'about' ? ' active-parent' : '' %>">
          <a href="/about"<%= active === 'about' ? ' class="active" aria-current="page"' : '' %> aria-haspopup="true">
            <%= t.nav_about %>
            <svg class="dd-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <ul class="dropdown">
            <li><a href="/about"<%= path === '/about' ? ' class="active"' : '' %>><%= t.nav_about_us %></a></li>
            <li><a href="/programmes"<%= path === '/programmes' ? ' class="active"' : '' %>><%= t.nav_programmes %></a></li>
            <li><a href="/voices"<%= path === '/voices' ? ' class="active"' : '' %>><%= t.nav_testimonies %></a></li>
            <li><a href="/accountability"<%= path === '/accountability' ? ' class="active"' : '' %>><%= t.nav_accountability %></a></li>
          </ul>
        </li>

        <li class="has-dropdown<%= active === 'impact' ? ' active-parent' : '' %>">
          <a href="/partners"<%= active === 'impact' ? ' class="active" aria-current="page"' : '' %> aria-haspopup="true">
            <%= t.nav_impact %>
            <svg class="dd-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <ul class="dropdown">
            <li><a href="/partners"<%= path === '/partners' ? ' class="active"' : '' %>><%= t.nav_partners %></a></li>
            <li><a href="/2026"<%= path === '/2026' ? ' class="active"' : '' %>><%= t.nav_priorities %></a></li>
          </ul>
        </li>

        <li><a href="/gallery"<%= active === 'gallery' ? ' class="active" aria-current="page"' : '' %>><%= t.nav_gallery %></a></li>
        <li><a href="/contact"<%= active === 'contact' ? ' class="active" aria-current="page"' : '' %>><%= t.nav_contact %></a></li>
      </ul>
    </nav>

    <div class="header-right">
      <button id="theme-toggle" class="theme-toggle-btn" type="button" aria-label="Basculer le mode sombre / clair" title="Mode sombre / clair">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

    </div>
  </div>
</header>
<main id="main">
