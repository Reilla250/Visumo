<%
  const im = c.img[file];
  const dims = { 'hero-community.jpg': [1400, 933] }[file] || [1400, 1050];
  if (im) {
%>
<figure class="figure <%= locals.cls || '' %>">
  <img src="/img/<%= im.filename %>" alt="<%= im.alt_text %>" width="<%= dims[0] %>" height="<%= dims[1] %>"<%- locals.eager ? '' : ' loading="lazy"' %>>
  <figcaption><%= im.caption %></figcaption>
</figure>
<% } %>
