<!doctype html>
<html lang="fr" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Connexion Administration | VISUMO</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=<%= assetV %>">
  <style>
    .login-body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f4f9f7;
      padding: 2rem 1rem;
      font-family: var(--sans);
    }
    .login-card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border-radius: 18px;
      padding: 2.5rem 2rem;
      box-shadow: 0 4px 24px rgba(13, 131, 99, 0.08), 0 1px 3px rgba(0,0,0,0.04);
      border: 1px solid #e1eee9;
    }
    .login-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .login-brand-img {
      width: 64px;
      height: 64px;
      margin: 0 auto 1rem;
      display: block;
      object-fit: contain;
    }
    .login-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #0f2923;
      margin: 0 0 0.5rem;
    }
    .login-subtitle {
      color: #557069;
      font-size: 0.9375rem;
      margin: 0;
    }
    .login-error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .login-field {
      margin-bottom: 1.25rem;
    }
    .login-field label {
      display: block;
      font-weight: 600;
      font-size: 0.875rem;
      color: #1a332d;
      margin-bottom: 0.4rem;
    }
    .login-field input {
      width: 100%;
      box-sizing: border-box;
      padding: 0.8rem 1rem;
      border: 1.5px solid #d3e4df;
      border-radius: 10px;
      font-size: 0.95rem;
      background: #fafdfc;
      color: #14221f;
      transition: border-color .15s, box-shadow .15s;
    }
    .login-field input:focus {
      outline: none;
      border-color: #0d8363;
      box-shadow: 0 0 0 3px rgba(13, 131, 99, 0.15);
      background: #ffffff;
    }
    .login-btn {
      width: 100%;
      padding: 0.85rem;
      background: #0d8363;
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: background .2s, transform .1s;
      box-shadow: 0 2px 8px rgba(13, 131, 99, 0.25);
    }
    .login-btn:hover {
      background: #09634b;
    }
    .login-btn:active {
      transform: scale(0.99);
    }
    .login-footer {
      text-align: center;
      margin-top: 1.75rem;
      padding-top: 1.25rem;
      border-top: 1px solid #edf5f2;
      font-size: 0.875rem;
    }
    .login-footer a {
      color: #0d8363;
      text-decoration: none;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .login-footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body class="login-body">
  <div class="login-card">
    <div class="login-header">
      <img src="/img/visumo-mark.png" alt="Logo VISUMO" class="login-brand-img">
      <h1 class="login-title">Administration VISUMO</h1>
      <p class="login-subtitle">Connectez-vous pour gérer votre site</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="login-error">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/admin/login" autocomplete="on">
      <div class="login-field">
        <label for="username">Nom d'utilisateur</label>
        <input type="text" id="username" name="username" required autofocus placeholder="admin" value="<%= typeof username !== 'undefined' ? username : '' %>" autocomplete="username">
      </div>

      <div class="login-field">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required placeholder="••••••••••••" autocomplete="current-password">
      </div>

      <button type="submit" class="login-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Se connecter
      </button>
    </form>

    <div class="login-footer">
      <a href="/">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Retour au site public
      </a>
    </div>
  </div>
</body>
</html>
