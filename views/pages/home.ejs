<%- include('../partials/head') %>

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><%= t.hero_eyebrow %> <span aria-hidden="true">·</span> <%= t.hero_location %></p>
      <h1><%= c.settings.hero_headline %></h1>
      <p class="lead"><%= c.settings.tagline %></p>
      <div class="btn-row">
        <a class="btn" href="/about"><%= t.nav_about_us %></a>
        <a class="btn btn-ghost" href="/contact"><%= t.hero_cta_partner %></a>
      </div>
      <p class="motto" lang="sw"><%= c.settings.sw_motto %></p>
    </div>
    <%- include('../partials/figure', { file: 'hero-community.jpg', cls: 'hero-fig', eager: true }) %>
  </div>
</section>

<section class="section">
  <div class="wrap two-col">
    <div>
      <p class="eyebrow"><%= t.who_we_are %></p>
      <h2><% if (lang === 'en') { %>A local organisation led by survivors<% } else if (lang === 'sw') { %>Shirika la ndani linaloongozwa na waathirika<% } else { %>Une organisation locale dirigée par des survivantes<% } %></h2>
      <p><%= c.paras[3][0] %></p>
      <p><%= c.paras[3][1] %></p>
      <p><a class="more" href="/about#s3"><%= t.read_more %> &rarr;</a></p>
    </div>
    <div>
      <%- include('../partials/callout', { slug: 'identity-statement' }) %>
      <%- include('../partials/callout', { slug: 'guiding-principle' }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap narrow-block">
    <%- include('../partials/callout', { slug: 'message-to-partners' }) %>
    <p class="center"><a class="btn" href="/contact"><%= t.contact_us %></a></p>
  </div>
</section>

<%- include('../partials/foot') %>
