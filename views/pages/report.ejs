<%- include('../partials/head') %>

<header class="page-title">
  <div class="wrap">
    <p class="eyebrow"><%= t.report_eyebrow %></p>
    <h1><%= t.report_title %></h1>
    <p class="lead"><%= t.report_lead_prefix %> <%= c.settings.reporting_period %>. <%= t.report_lead_suffix %></p>
  </div>
</header>

<section class="section alt">
  <div class="wrap">
    <p class="eyebrow"><%= t.report_resources_eyebrow %></p>
    <h2><%= t.report_resources_title %></h2>
    <div class="cards">
      <article class="card resource-card">
        <h3><%= t.report_card1_title %></h3>
        <p><%= t.report_card1_desc %></p>
        <a class="btn btn-sm" href="/downloads/VISUMO_Annual_Narrative_Report_2025.docx" download><%= t.report_card1_btn %></a>
      </article>
      <article class="card resource-card">
        <h3><%= t.report_card2_title %></h3>
        <p><%= t.report_card2_desc %></p>
        <a class="btn btn-sm" href="/downloads/VISUMO_Statuts_FR.docx" download><%= t.report_card2_btn %></a>
      </article>
      <article class="card resource-card">
        <h3><%= t.report_card3_title %></h3>
        <p><%= t.report_card3_desc %></p>
        <a class="btn btn-sm" href="/downloads/VISUMO_Official_Letterhead.jpg" download><%= t.report_card3_btn %></a>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <%- include('../partials/callout', { slug: 'report-focus' }) %>
    <%- include('../partials/section-head', { n: 2 }) %>
    <div class="table-wrap narrow-table">
      <table>
        <caption class="sr-only"><%= t.report_toc_title %></caption>
        <thead><tr><th scope="col"><%= t.report_toc_col_sec %></th><th scope="col"><%= t.report_toc_col_part %></th></tr></thead>
        <tbody>
          <% c.contents.forEach(function (s) { %>
          <tr><th scope="row"><%= s.section_number %></th><td><%= s.title %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/callout', { slug: 'evidence-note' }) %>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <%- include('../partials/section-head', { n: 19 }) %>
    <div class="table-wrap">
      <table>
        <caption class="sr-only"><%= t.report_evidence_title %></caption>
        <thead><tr><th scope="col"><%= t.report_evidence_col_source %></th><th scope="col"><%= t.report_evidence_col_use %></th></tr></thead>
        <tbody>
          <% c.evidence.forEach(function (r) { %>
          <tr><th scope="row"><%= r.source_item %></th><td><%= r.report_use %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="narrow"><%= c.paras[19][0] %></p>
    <%- include('../partials/callout', { slug: 'quality-assurance' }) %>
    <%- include('../partials/callout', { slug: 'external-sharing' }) %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2><%= t.report_doc_info_title %></h2>
    <div class="table-wrap narrow-table">
      <table>
        <caption class="sr-only"><%= t.report_doc_info_title %></caption>
        <thead><tr><th scope="col"><%= t.report_doc_info_col_field %></th><th scope="col"><%= t.report_doc_info_col_details %></th></tr></thead>
        <tbody>
          <% c.docControl.forEach(function (r) { %>
          <tr><th scope="row"><%= r.field_name %></th><td><%= r.details %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/section-head', { n: 21 }) %>
    <div class="prose">
      <% c.paras[21].forEach(function (p) { %><p><%= p %></p><% }) %>
      <p class="small muted"><%= t.report_sign_note %></p>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
