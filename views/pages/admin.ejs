<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Administration | VISUMO</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetV %>">
</head>
<body class="admin-body">

<div class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-brand">
      <img src="/img/visumo-mark.png" alt="" width="36" height="36">
      <div>
        <strong>VISUMO</strong>
        <small>Administration</small>
      </div>
    </div>
    <nav class="admin-nav">
      <a href="/admin?section=dashboard" class="<%= section === 'dashboard' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Tableau de bord
      </a>
      <a href="/admin?section=gallery" class="<%= section === 'gallery' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        Galerie
        <span class="admin-badge"><%= totalImages %></span>
      </a>
      <a href="/admin?section=content" class="<%= section === 'content' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        Contenu
      </a>
      <a href="/admin?section=messages" class="<%= section === 'messages' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        Messages
        <% if (unreadCount > 0) { %><span class="admin-badge warn"><%= unreadCount %></span><% } %>
      </a>
    </nav>
    <div class="admin-sidebar-footer">
      <a href="/" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Voir le site
      </a>
      <form method="POST" action="/admin/cache/clear" class="inline">
        <button type="submit" class="admin-link-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M21 21v-5h-5"/></svg>
          Vider le cache
        </button>
      </form>
      <a href="/admin/logout" class="admin-logout-link" style="margin-top: 0.5rem; color: #dc2626; display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; text-decoration: none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Déconnexion (<%= typeof adminUser !== 'undefined' ? adminUser : 'admin' %>)
      </a>
    </div>
  </aside>

  <!-- Main content -->
  <main class="admin-main">

    <!-- ====== DASHBOARD ====== -->
    <% if (section === 'dashboard') { %>
    <div class="admin-header">
      <h1>Tableau de bord</h1>
      <p class="muted">Vue d'ensemble de votre site VISUMO</p>
    </div>

    <div class="admin-stats">
      <div class="admin-stat-card">
        <div class="admin-stat-icon" style="background: linear-gradient(135deg, #0e7c6b, #2da895);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        </div>
        <div>
          <span class="admin-stat-num"><%= messages.length %></span>
          <span class="admin-stat-label">Messages</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon" style="background: linear-gradient(135deg, #c88c2a, #f0c96b);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        </div>
        <div>
          <span class="admin-stat-num"><%= unreadCount %></span>
          <span class="admin-stat-label">Non lus</span>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon" style="background: linear-gradient(135deg, #1e8c5a, #6fcf97);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </div>
        <div>
          <span class="admin-stat-num"><%= totalImages %></span>
          <span class="admin-stat-label">Photos galerie</span>
        </div>
      </div>
    </div>

    <div class="admin-section">
      <h2>Messages récents</h2>
      <% if (messages.length === 0) { %>
        <p class="muted">Aucun message pour le moment.</p>
      <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Nom</th><th>E-mail</th><th>Objet</th><th>Date</th><th>Statut</th></tr>
            </thead>
            <tbody>
              <% messages.slice(0, 5).forEach(function (m) { %>
              <tr class="<%= m.is_read ? 'read' : '' %>">
                <td><strong><%= m.full_name %></strong></td>
                <td><%= m.email %></td>
                <td><%= m.subject %></td>
                <td class="nowrap"><%= new Date(m.created_at).toLocaleDateString('fr-FR') %></td>
                <td><span class="status-badge <%= m.is_read ? 'read' : 'unread' %>"><%= m.is_read ? 'Lu' : 'Nouveau' %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p><a href="/admin?section=messages" class="more">Voir tous les messages →</a></p>
      <% } %>
    </div>
    <% } %>

    <!-- ====== GALLERY ====== -->
    <% if (section === 'gallery') { %>
    <div class="admin-header">
      <h1>Gestion de la galerie</h1>
      <p class="muted">Ajoutez, gérez et supprimez les photos de votre galerie</p>
    </div>

    <% if (typeof query !== 'undefined' && query && query.success === 'uploaded') { %>
    <div class="admin-notice ok" style="background: #e6f7f1; border: 1px solid #10b981; color: #047857; padding: 0.85rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 500;">
      ✓ Photo ajoutée avec succès à la galerie !
    </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query && query.error) { %>
    <div class="admin-notice warn" style="background: #fef2f2; border: 1px solid #ef4444; color: #b91c1c; padding: 0.85rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem;">
      ⚠ Erreur lors de l'envoi de la photo : <%= query.error %>. Assurez-vous de sélectionner une image valide (JPG, PNG, WebP) de moins de <%= vercelRuntime ? '4' : '8' %> Mo.
    </div>
    <% } %>

    <div class="admin-section">
      <h2>Ajouter une photo</h2>
      <form method="POST" action="/admin/gallery/upload" enctype="multipart/form-data" class="upload-form">
        <div class="upload-area" id="upload-area">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p>Glissez une image ici ou <strong>cliquez pour choisir</strong></p>
          <p class="small muted">JPG, PNG, WebP ou GIF · Max <%= vercelRuntime ? '4' : '8' %> Mo</p>
          <input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.gif" required id="upload-input">
        </div>
        <div class="upload-fields">
          <div class="field">
            <label for="caption">Légende</label>
            <input type="text" id="caption" name="caption" placeholder="Décrivez la photo..." maxlength="300">
          </div>
          <div class="field">
            <label for="alt_text">Texte alternatif (accessibilité)</label>
            <input type="text" id="alt_text" name="alt_text" placeholder="Description pour les lecteurs d'écran..." maxlength="300">
          </div>
          <button type="submit" class="btn admin-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Ajouter la photo
          </button>
        </div>
      </form>
    </div>

    <div class="admin-section">
      <h2>Photos existantes (<%= galleryImages.length %>)</h2>
      <% if (galleryImages.length === 0) { %>
        <p class="muted">Aucune photo dans la galerie.</p>
      <% } else { %>
        <div class="admin-gallery-grid">
          <% galleryImages.forEach(function (img) { %>
            <div class="admin-gallery-card">
              <div class="admin-gallery-img">
                <img src="<%= img.stored_in_database ? '/gallery/image/' + img.id : '/img/gallery/' + img.filename %>" alt="<%= img.alt_text || img.caption %>" loading="lazy">
              </div>
              <div class="admin-gallery-info">
                <p class="caption"><%= img.caption || 'Sans légende' %></p>
                <p class="small muted"><%= new Date(img.created_at).toLocaleDateString('fr-FR') %></p>
                <form method="POST" action="/admin/gallery/<%= img.id %>/delete" class="inline"
                      onsubmit="return confirm('Supprimer cette photo ?')">
                  <button type="submit" class="admin-delete-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Supprimer
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% } %>

    <!-- ====== CONTENT ====== -->
    <% if (section === 'content') { %>
    <div class="admin-header">
      <h1>Gestion du contenu</h1>
      <p class="muted">Modifiez les textes principaux de votre site</p>
    </div>

    <div class="admin-section">
      <form method="POST" action="/admin/content/update" class="admin-content-form">
        <div class="field">
          <label for="site_name">Nom du site</label>
          <input type="text" id="site_name" name="site_name" value="<%= settings.site_name || '' %>" maxlength="200">
        </div>
        <div class="field">
          <label for="org_full_name">Nom complet de l'organisation</label>
          <input type="text" id="org_full_name" name="org_full_name" value="<%= settings.org_full_name || '' %>" maxlength="500">
        </div>
        <div class="field">
          <label for="hero_headline">Titre héro (page d'accueil)</label>
          <textarea id="hero_headline" name="hero_headline" rows="2" maxlength="500"><%= settings.hero_headline || '' %></textarea>
        </div>
        <div class="field">
          <label for="tagline">Slogan / description</label>
          <textarea id="tagline" name="tagline" rows="3" maxlength="1000"><%= settings.tagline || '' %></textarea>
        </div>
        <div class="field">
          <label for="sw_motto">Devise en swahili</label>
          <input type="text" id="sw_motto" name="sw_motto" value="<%= settings.sw_motto || '' %>" maxlength="300">
        </div>
        <div class="field">
          <label for="footer_note">Note de pied de page</label>
          <input type="text" id="footer_note" name="footer_note" value="<%= settings.footer_note || '' %>" maxlength="500">
        </div>
        <button type="submit" class="btn admin-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Enregistrer les modifications
        </button>
      </form>
    </div>
    <% } %>

    <!-- ====== MESSAGES ====== -->
    <% if (section === 'messages') { %>
    <div class="admin-header">
      <h1>Messages reçus</h1>
      <p class="muted"><%= messages.length %> message<%= messages.length !== 1 ? 's' : '' %> · <%= unreadCount %> non lu<%= unreadCount !== 1 ? 's' : '' %></p>
    </div>

    <div class="admin-section">
      <% if (messages.length === 0) { %>
        <p class="muted">Aucun message reçu.</p>
      <% } else { %>
        <div class="admin-messages">
          <% messages.forEach(function (m) { %>
            <div class="admin-msg <%= m.is_read ? 'read' : '' %>">
              <div class="admin-msg-header">
                <div>
                  <strong><%= m.full_name %></strong>
                  <span class="muted"><%= m.email %></span>
                  <% if (m.organisation) { %><span class="muted">· <%= m.organisation %></span><% } %>
                </div>
                <div class="admin-msg-actions">
                  <span class="status-badge <%= m.is_read ? 'read' : 'unread' %>"><%= m.is_read ? 'Lu' : 'Nouveau' %></span>
                  <span class="muted nowrap"><%= new Date(m.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                </div>
              </div>
              <h3><%= m.subject %></h3>
              <p class="pre"><%= m.message %></p>
              <div class="admin-msg-footer">
                <% if (!m.is_read) { %>
                  <form method="POST" action="/admin/messages/<%= m.id %>/read" class="inline">
                    <button type="submit" class="admin-action-btn">✓ Marquer comme lu</button>
                  </form>
                <% } %>
                <form method="POST" action="/admin/messages/<%= m.id %>/delete" class="inline"
                      onsubmit="return confirm('Supprimer ce message ?')">
                  <button type="submit" class="admin-delete-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Supprimer
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% } %>

  </main>
</div>

<script>
// Upload area drag & drop
(function() {
  var area = document.getElementById('upload-area');
  var input = document.getElementById('upload-input');
  if (!area || !input) return;

  area.addEventListener('click', function() { input.click(); });
  area.addEventListener('dragover', function(e) { e.preventDefault(); area.classList.add('dragover'); });
  area.addEventListener('dragleave', function() { area.classList.remove('dragover'); });
  area.addEventListener('drop', function(e) {
    e.preventDefault();
    area.classList.remove('dragover');
    if (e.dataTransfer.files.length) {
      input.files = e.dataTransfer.files;
      area.querySelector('p').textContent = e.dataTransfer.files[0].name;
    }
  });
  input.addEventListener('change', function() {
    if (input.files.length) {
      area.querySelector('p').textContent = input.files[0].name;
    }
  });
})();
</script>

</body>
</html>
